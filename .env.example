# Server Configuration
SERVER_PORT=8080
LOG_LEVEL=info

# Database Configuration (Microsoft SQL Server)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong!Password123
MSSQL_DB=HBYS
MSSQL_ENCRYPT=true

# API Authentication
# Format: service1:apikey1,service2:apikey2
# Generate API keys using: go run cmd/keygen/main.go -service <service-name>
API_KEYS=service1:your-api-key-here,service2:another-api-key

# Examples:
# API_KEYS=frontend:abc123def456,mobile-app:xyz789uvw012
