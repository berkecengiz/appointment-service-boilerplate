# Server Configuration
SERVER_PORT=8080
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
# PG_HOST is used for local runs (go run, tests). PG_HOST_DOCKER feeds docker-compose.
PG_HOST=localhost
PG_HOST_DOCKER=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=appointments
PG_SSLMODE=disable

# API Authentication
# Format: service1:apikey1,service2:apikey2
# Generate API keys using: go run cmd/keygen/main.go -service <service-name>
API_KEYS=local-dev:replace-with-real-key
